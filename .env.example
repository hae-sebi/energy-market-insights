# Copy to .env and adjust. Never commit .env.

# SQLite database file
EMI_DB_PATH=data/emi.sqlite

# Flexible load definitions (YAML)
EMI_LOADS_PATH=config/loads.yaml

# DEBUG | INFO | WARNING | ERROR | CRITICAL
EMI_LOG_LEVEL=INFO

# Optional LLM assistant: only active if enabled AND an API key is set
EMI_ASSISTANT_ENABLED=false
EMI_ASSISTANT_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
